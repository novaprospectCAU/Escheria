{
  "name": "escheria",
  "version": "0.1.0",
  "description": "Browser-based non-Euclidean rendering engine for exploring hyperbolic space",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:all": "pnpm build:wasm && pnpm build",
    "preview": "vite preview",
    "wasm:setup": "mkdir -p wasm/build public/wasm",
    "wasm:configure": "cd wasm/build && emcmake cmake ..",
    "wasm:compile": "cd wasm/build && emmake make",
    "wasm:clean": "rm -rf wasm/build public/wasm/*.js public/wasm/*.wasm",
    "build:wasm": "pnpm wasm:setup && pnpm wasm:configure && pnpm wasm:compile"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-glsl": "^1.3.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0"
  }
}
